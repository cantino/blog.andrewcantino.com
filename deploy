#!/bin/sh
set -e
bundle exec jekyll build

OP_ITEM="op://Private/aws-my-website"
AWS_ACCESS_KEY_ID=$(op read "$OP_ITEM/access-key-id")
AWS_SECRET_ACCESS_KEY=$(op read "$OP_ITEM/secret-access-key")
export AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY
export AWS_DEFAULT_REGION=us-east-1
unset AWS_PROFILE AWS_SESSION_TOKEN

aws s3 sync _site/ s3://blog.andrewcantino.com/ --delete
aws cloudfront create-invalidation --distribution-id E8R02RR0JALL3 --paths "/*"
open 'https://blog.andrewcantino.com'
